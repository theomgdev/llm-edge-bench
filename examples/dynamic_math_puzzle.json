    "puzzle_fail": {
      "id": "puzzle_fail",
      "type": "end",
      "title": "Calculation Error",
      "prompt": "",
      "timeoutMs": 5000,
      "systemPrompt": null,
      "params": null,
      "maxAttempts": null,
      "memory": null,
      "historyTurns": null,
      "retryMemory": null,
      "trialCounter": null,
      "resetContextOnEnter": false,
      "fallback": "retry",
      "fallbackTarget": null,
      "onExhausted": "stop",
      "onExhaustedTarget": null,
      "score": -10,
      "tags": [],
      "outcome": "fail",
      "edges": [],
      "ui": {
        "x": 1160,
        "y": 240
