    }
  },
  "settings": {
    "systemPrompt": "",
    "memory": "isolated",
    "historyTurns": 4,
    "retryMemory": "keep",
    "retryMemoryNote": "Your previous answer was not accepted.",
    "trialCounter": {
      "enabled": false,
      "template": "[Attempt {{attempt}}/{{budget}}]",
      "position": "prefix",
      "skipFirst": true
    },
    "cacheBuster": {
      "enabled": true,
      "mode": "user"
    },
    "maxSteps": 40,
    "maxMs": 600000,
    "defaultMaxAttempts": 5,
    "normalize": {
      "thinking": true,
      "markdown": false,
      "lower": true,
      "punctuation": false,
      "trim": true,
      "whitespace": true
    },
    "params": {
      "temperature": 0.2
    },
    "allowExpr": true
  }
}